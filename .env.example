# ============ Telegram Bot ============
# Токен от @BotFather
BOT_TOKEN=
# Telegram ID владельцев через запятую (узнать свой ID: @ScanMyIdRobot)
ADMIN_IDS=

# ============ База данных ============
# Для Docker Compose: пароль PostgreSQL (только латиница и цифры).
# DATABASE_URL в Docker собирается автоматически из этих переменных.
POSTGRES_DB=support_bot
POSTGRES_USER=support_bot
POSTGRES_PASSWORD=
# Для локального запуска без Docker — SQLite:
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# или свой PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/support_bot

# Необязательно: Redis для FSM (в Docker задаётся автоматически)
# REDIS_URL=redis://localhost:6379/0

# ============ Поддержка ============
SUPPORT_MAX_TICKETS=3
# Юзернейм для ссылки «Написать в ЛС поддержки» (без @)
SUPPORT_USERNAME=nudick

# ============ Портфолио (стартовые значения, дальше — в админке) ============
PORTFOLIO_URL=https://jentiazzz-debug.github.io/solutions/
PORTFOLIO_CHANNEL_URL=https://t.me/+xLZCiaRHdjdmMWVi
COMMUNITY_CHAT_URL=https://t.me/+zDC0T-N-T5M4ZGUy

# ============ Дополнительный аккаунт (Telethon) ============
# https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Ключ шифрования сессий. Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: не меняйте после подключения аккаунта — иначе сессию не расшифровать.
SESSION_ENCRYPTION_KEY=

# ============ Прочее ============
PREMIUM_EMOJI_ENABLED=true
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
# Скорость рассылки, сообщений в секунду (лимит Telegram ~30)
BROADCAST_RATE=20
